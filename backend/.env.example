# ==============================================================================
# WB SCOUTING - MODELO DE VARIÁVEIS DE AMBIENTE LOCAL / CI (.env.example)
# AVISO DE SEGURANÇA:
# NUNCA insira credenciais reais, senhas de produção ou chaves de API neste arquivo!
# Copie este arquivo para '.env' e preencha os valores para seu ambiente local:
#   cp .env.example .env
# ==============================================================================

# Conexão com Banco de Dados PostgreSQL (Local ou Supabase Pooler)
# Exemplo local: jdbc:postgresql://localhost:5432/wb_scouting
# Exemplo Supabase: jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
DB_URL=jdbc:postgresql://localhost:5432/wb_scouting
DB_USERNAME=postgres
DB_PASSWORD=sua_senha_do_banco_aqui

# Autenticação JWT (Chave Base64 HMAC-SHA256/384 de no mínimo 256 bits)
# Gere uma chave segura via: openssl rand -base64 32
JWT_SECRET=sua_chave_secreta_jwt_minimo_256_bits_base64_aqui
JWT_EXPIRATION_MS=28800000

# Integração com Supabase Storage e API
SUPABASE_URL=https://seu-projeto-id.supabase.co
SUPABASE_KEY=sua_chave_supabase_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui
SUPABASE_ANON_KEY=sua_anon_key_aqui

# Configurações do Servidor e CORS
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://wbagency.com.br,https://www.wbagency.com.br

# Configurações de E-mail SMTP (Opcional para ambiente local)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@wbscouting.com
MAIL_PASSWORD=sua_senha_de_app_smtp_aqui
MAIL_FROM=no-reply@wbscouting.com
AGENCY_CONTACT_EMAIL=contato@wbscouting.com